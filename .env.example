# Required (used for WhatsApp pairing and inbound sender allowlist)
WA_BOT_PHONE_NUMBER=15551234567

# Optional
HOST=127.0.0.1
PORT=3001
WA_AUTH_DIR=./whatsapp-auth
PAIRING_DELAY_MS=5000
# Ignore older inbound messages for this many ms after connect
INBOUND_HISTORY_GRACE_MS=30000
WA_LOG_LEVEL=silent
